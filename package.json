{
  "name": "effect-datastar",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/build.ts --watch",
    "start": "npm run build && npm run serve",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "build": "tsx scripts/build.ts",
    "serve": "node --enable-source-maps dist/server.js"
  },
  "dependencies": {
    "@effect/platform-node": "^4.1.5",
    "@effect/sql-sqlite-node": "^4.1.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/allura": "^5.3.0",
    "@stylexjs/stylex": "0.19.2",
    "@ui-sdk/core": "0.1.0-beta.10",
    "@ui-sdk/react": "0.1.0-beta.10",
    "effect": "^4.1.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@effect/vitest": "^4.1.5",
    "@stylexjs/unplugin": "0.19.2",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "7.3.8",
    "vitest": "^5.1.1"
  }
}
