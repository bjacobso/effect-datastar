{
  "name": "effect-datastar",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @effect-datastar/demo",
    "dev:board": "npm run dev -w @effect-datastar/board",
    "start": "npm start -w @effect-datastar/demo",
    "build": "npm run build -w @effect-datastar/demo",
    "build:board": "npm run build -w @effect-datastar/board",
    "serve": "npm run serve -w @effect-datastar/demo",
    "load": "npm run load -w @effect-datastar/demo --",
    "typecheck": "tsc --noEmit -p . && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "npm run test:e2e -w @effect-datastar/demo",
    "test:e2e:board": "npm run test:e2e -w @effect-datastar/board"
  },
  "devDependencies": {
    "@effect/vitest": "^4.1.5",
    "@stylexjs/unplugin": "0.19.2",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "7.3.8",
    "vitest": "^5.1.1"
  }
}
